<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Centralized Versioning (Prerelease by default) -->
    <VersionPrefix>0.7.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">preview</VersionSuffix>

    <!-- Common NuGet Package Metadata -->
    <Authors>Nicolas Ponsart</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/nicopon/TransportR</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <!-- Each package ships the README.md beside its project as its NuGet page. Samples and tests
       have READMEs too, but are not packed (below). -->
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)/README.md')">
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/README.md')">
    <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <!-- Samples and tests are not published as NuGet packages -->
  <PropertyGroup Condition="$(MSBuildProjectFullPath.Contains('samples')) or $(MSBuildProjectFullPath.Contains('tests'))">
    <IsPackable>false</IsPackable>
    <WarnOnPackingNonPackableProject>false</WarnOnPackingNonPackableProject>
  </PropertyGroup>
</Project>
