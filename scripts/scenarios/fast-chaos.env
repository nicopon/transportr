# scripts/scenarios/fast-chaos.env - Fast Chaos testing with network simulation

# Scenario description
SCENARIO_NAME="Fast Chaos Benchmark (Network Simulation)"
SCENARIO_EXPECTED="SUCCESS with retries/reconnections"

# Authentication
ENABLE_AUTH=false
ENABLE_IDP=false

# Configuration
BATCH_SIZE=500
BATCH_FLUSH_INTERVAL_MS=10000
NUM_SENDERS=1
NUM_RECEIVERS=1

# Network simulation
ENABLE_CHAOS=true
TOXIPROXY_PORT=8474
NUM_ITEMS=200000
