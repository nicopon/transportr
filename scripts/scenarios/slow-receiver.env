# scripts/scenarios/slow-receiver.env - Bounded receive buffer against a throttled consumer
#
# The demonstration that the receive buffer bounds MEMORY and not just a count. The consumer is
# capped well under what the sender produces, so the buffer fills and stays full for most of the
# run; the byte bound is what decides how much that costs.
#
# The item bound is set deliberately high here so that it never binds: this scenario is about the
# byte dimension alone. Its control is slow-receiver-unbounded-bytes.env, which differs by that
# one line and is expected to grow — do not add that one to test-all.sh.

# Scenario description
SCENARIO_NAME="Slow Receiver (Byte-Bounded Receive Buffer)"
SCENARIO_EXPECTED="SUCCESS with a flat receiver footprint"

# Authentication
ENABLE_AUTH=false
ENABLE_IDP=false

# Configuration
BATCH_SIZE=500
BATCH_FLUSH_INTERVAL_MS=1000
NUM_SENDERS=1
NUM_RECEIVERS=1

# The consumer is the bottleneck, and it has to be the consumer: throttling the source would
# leave the buffer empty and prove nothing.
CONSUME_ITEMS_PER_SECOND=200000

# Receive capacity: the count is out of the way, the bytes are the bound.
RECEIVE_MAX_ITEMS=500000
RECEIVE_MAX_BYTES=8388608

# The assertion. Measured, not guessed: 182 MB on this scenario, against 870 MB for the control
# that differs only by the byte bound. The ceiling leaves room for GC timing and a different
# machine, and still fails long before anything resembling the unbounded figure.
MAX_RECEIVER_RSS_MB=300

# Transport: the default policy prefers a WebSocket, and this run must not have needed segments
ASSERT_WRITE_TRANSPORT=WebSocket
