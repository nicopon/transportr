# scripts/scenarios/data-plane-probe.env - the data plane refuses non-participants, under load

# Scenario description
SCENARIO_NAME="Data Plane Probe (participant check under OIDC)"
SCENARIO_EXPECTED="SUCCESS with anonymous and wrong-role stream requests refused"

# Authentication — the check only runs when there is an attested identity to compare
ENABLE_AUTH=true
ENABLE_IDP=true
IDP_PORT=5100

# Probe
PROBE_DATA_PLANE=true

# Configuration
BATCH_SIZE=5000
BATCH_FLUSH_INTERVAL_MS=10000
NUM_SENDERS=1
NUM_RECEIVERS=1

# The probe has to land while the streams are open, so the receiver is paced to keep the transfer
# alive for the few seconds the six requests take.
CONSUME_ITEMS_PER_SECOND=200000

# Transport: the default policy prefers a WebSocket, and this run must not have needed segments
ASSERT_WRITE_TRANSPORT=WebSocket

# Network simulation
ENABLE_CHAOS=false
