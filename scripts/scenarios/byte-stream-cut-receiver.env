# scripts/scenarios/byte-stream-cut-receiver.env - One silent cut of the receiver's link, in the byte-stream mode
#
# chaos-cut-receiver.env for a source carried as bytes: the receiver alone is behind Toxiproxy, and
# mid-transfer the proxy holds every byte, then closes all its connections. A receiver that holds chunks
# its consumer has not taken loses nothing it admitted: the ones in the receive buffer and in the
# reordering buffer are the pooled copies that reconnection discards or keeps, and a chunk disposed twice
# or not at all corrupts the file or stalls the resend. The run is judged on size and SHA-256.
#
# The window is one batch and the batch 64 KiB, as in byte-stream-cut-sender.env, so that the hold finds
# the transfer under way. The run checks it, as for any hold.

# Scenario description
SCENARIO_NAME="Silent Cut of the Receiver's Link, Byte Stream"
SCENARIO_EXPECTED="SUCCESS: the transfer resumes after the link comes back, and the file is the source"

# Authentication
ENABLE_AUTH=false
ENABLE_IDP=false

# Configuration
BYTE_STREAM_BATCH_BYTES=65536
MAX_IN_FLIGHT_BATCHES=1
RECEIVE_MAX_BYTES=8388608
NUM_SENDERS=1
NUM_RECEIVERS=1

# Network simulation
ENABLE_CHAOS=true
TOXIPROXY_PORT=8474
CHAOS_CLIENTS=receiver
CHAOS_PROGRAM=hold
CHAOS_HOLD_START_SECONDS=2
CHAOS_HOLD_SECONDS=8
EXPECT_RESUME=true

TRANSFER_TIMEOUT_SECONDS=150
