# scripts/scenarios/segments-default.env - The default transfer with a WebSocket excluded
#
# Segments are what carries a write stream wherever a WebSocket does not pass, and what a client
# falls back to. This run is default.env with both clients told not to try one, and it must deliver
# every line over segments alone: the fallback path stays exercised by a run that does not depend on
# a WebSocket failing first.

# Scenario description
SCENARIO_NAME="Default Benchmark, Segments Only"
SCENARIO_EXPECTED="SUCCESS with every write stream carried by segments"

# Authentication
ENABLE_AUTH=false
ENABLE_IDP=false

# Configuration
BATCH_SIZE=500
BATCH_FLUSH_INTERVAL_MS=10000
NUM_SENDERS=1
NUM_RECEIVERS=1

# Transport: both clients are excluded from a WebSocket, and every opening must say so
WRITE_TRANSPORT=SegmentsOnly
ASSERT_WRITE_TRANSPORT=Segments

# Network simulation
ENABLE_CHAOS=false
