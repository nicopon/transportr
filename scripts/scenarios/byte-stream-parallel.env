# scripts/scenarios/byte-stream-parallel.env - Two byte-stream transfers at once, of one sender to two receivers
#
# One sender process opens a transfer to each of two receivers, the second two seconds after the first, and
# both carry the source file. Each has its own send window, its own receive buffer and its own pooled
# buffers: a buffer returned to the pool by one transfer and still read by the other would show as a
# file that is not the source. NUM_SENDERS counts the transfers this run must complete, as in
# ha-transfer-affinity.env.

# Scenario description
SCENARIO_NAME="Byte Stream, Two Transfers at Once"
SCENARIO_EXPECTED="SUCCESS: both receivers' files have the size and the SHA-256 of the source"

# Authentication
ENABLE_AUTH=false
ENABLE_IDP=false

# Configuration
BYTE_STREAM_BATCH_BYTES=1048576
MAX_IN_FLIGHT_BATCHES=8
RECEIVE_MAX_BYTES=8388608
NUM_SENDERS=2
NUM_RECEIVERS=2
SENDER_PARALLELISM=2
SENDER_TRANSFER_STAGGER_SECONDS=2

# Transport: the default policy prefers a WebSocket, and this run must not have needed segments
ASSERT_WRITE_TRANSPORT=WebSocket

# Network simulation
ENABLE_CHAOS=false

TRANSFER_TIMEOUT_SECONDS=150
