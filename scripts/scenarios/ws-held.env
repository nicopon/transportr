# scripts/scenarios/ws-held.env - A path that accepts a WebSocket upgrade and carries nothing
#
# The TestProxy takes the upgrade itself and relays nothing, the connection left open
# (PROXY_UPGRADE=hold): the handshake succeeds and the probe a client sends to prove the path is never
# answered. Each client must give the opening up once the bound for it has passed, say why in its
# log, and carry the whole transfer over segments, which the TestProxy does relay.
#
# The proxy logs the moment it accepts an upgrade, and the clients log the moment they give up: the
# difference is the time the fallback cost.

# Scenario description
SCENARIO_NAME="WebSocket Upgrade Accepted, Nothing Relayed (Fallback to Segments)"
SCENARIO_EXPECTED="SUCCESS over segments, each client giving up on its WebSocket within its bound"

# Authentication
ENABLE_AUTH=false
ENABLE_IDP=false

# Configuration
NUM_SENDERS=1
NUM_RECEIVERS=1
BATCH_SIZE=500
BATCH_FLUSH_INTERVAL_MS=500

# Infrastructure: two hubs behind the TestProxy, which holds the upgrade
ENABLE_HA=true
PROXY_UPGRADE=hold

# Transport: the default policy, which prefers a WebSocket
ASSERT_WRITE_TRANSPORT=Segments
EXPECT_WRITE_FALLBACK=true

TRANSFER_TIMEOUT_SECONDS=300
