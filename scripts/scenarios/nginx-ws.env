# scripts/scenarios/nginx-ws.env - Default benchmark through nginx configured to relay WebSocket upgrades

# Scenario description
SCENARIO_NAME="Default Benchmark Behind nginx (WebSocket Upgrade)"
SCENARIO_EXPECTED="SUCCESS with every write stream carried over WebSocket through nginx"

# Authentication
ENABLE_AUTH=false
ENABLE_IDP=false

# Proxy
ENABLE_NGINX=true
NGINX_TEMPLATE=ws.conf.template

# Configuration
BATCH_SIZE=500
BATCH_FLUSH_INTERVAL_MS=10000
NUM_SENDERS=1
NUM_RECEIVERS=1

# Transport: require and assert WebSocket through nginx
WRITE_TRANSPORT=RequireWebSocket
ASSERT_WRITE_TRANSPORT=WebSocket

# Network simulation
ENABLE_CHAOS=false
