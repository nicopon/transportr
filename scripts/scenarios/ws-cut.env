# scripts/scenarios/ws-cut.env - One silent cut of the sender's link, over a WebSocket
#
# chaos-cut-sender.env, with what it is for: the sender's data stream is a WebSocket when the link is
# held silent and then its connections are closed. The sender must open it again over a WebSocket
# once the link is back, and the transfer must deliver every line. A cut is one short-lived rupture,
# short of the three in a row after which a client gives up on a WebSocket. See chaos-cut-sender.env for
# the fault and the window.

# Scenario description
SCENARIO_NAME="Silent Cut of the Sender's Link, Over a WebSocket"
SCENARIO_EXPECTED="SUCCESS: the transfer resumes after the link comes back, over a WebSocket opened again"

# Authentication
ENABLE_AUTH=false
ENABLE_IDP=false

# Configuration
BATCH_SIZE=500
BATCH_FLUSH_INTERVAL_MS=10000
NUM_SENDERS=1
NUM_RECEIVERS=1
MAX_IN_FLIGHT_BATCHES=1

# Transport: the default policy, which prefers a WebSocket, and none of the fallbacks it allows
ASSERT_WRITE_TRANSPORT=WebSocket
EXPECT_WEBSOCKET_REOPENED=true

# Network simulation
ENABLE_CHAOS=true
TOXIPROXY_PORT=8474
CHAOS_CLIENTS=sender
CHAOS_PROGRAM=hold
CHAOS_HOLD_START_SECONDS=2
CHAOS_HOLD_SECONDS=8

TRANSFER_TIMEOUT_SECONDS=150
