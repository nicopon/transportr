# scripts/scenarios/ws-held-late.env - A path that lets the opening proof through, then retains the bytes
#
# The TestProxy accepts the upgrade, answers the client's first message and reads nothing after it, so
# the clients take their WebSocket for proven and then write into a connection nobody drains. No
# fallback can follow: the opening proof is the only test of the path, and it passed. What this run
# checks is the cost of that blind spot: the transfer must end in a failure the sender reports, within
# the stall bound of the client, and not hang. The hub never sees a write stream, so it has nothing to say.
#
# The send window is bounded so that the producer stops at the window and not at the end of the file.
# Scenario description
SCENARIO_NAME="WebSocket Proven, Then Retained by the Path (Stall Failure)"
SCENARIO_EXPECTED="FAILURE of the transfer, reported once the send window stayed full, and nothing delivered in full"
# Authentication
ENABLE_AUTH=false
ENABLE_IDP=false
# Configuration
BATCH_SIZE=500
BATCH_FLUSH_INTERVAL_MS=500
NUM_SENDERS=1
NUM_RECEIVERS=1
MAX_IN_FLIGHT_BATCHES=8
# Infrastructure: two hubs behind the TestProxy, which retains the bytes after the proof
ENABLE_HA=true
PROXY_UPGRADE=hold-late
# The assertion
EXPECT_TRANSFER_FAILURE=true
EXPECT_FAILURE_MESSAGE="send window stayed full"
EXPECT_HUB_LOG=
# The stall bound of the client is 60s; the rest is the slack of the start-up and of the first segments.
TRANSFER_TIMEOUT_SECONDS=150
