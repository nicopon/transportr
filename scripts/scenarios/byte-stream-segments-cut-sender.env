# scripts/scenarios/byte-stream-segments-cut-sender.env - One silent cut of the sender's link, in the byte-stream mode, over segments
#
# byte-stream-cut-sender.env with both clients told not to use a WebSocket. A segmented write stream
# resumes from an epoch and an offset, not from a close status: a different resend path from the
# WebSocket's, and the one whose bytes are the sender's pooled copies. See byte-stream-cut-sender.env for
# the fault and the window.

# Scenario description
SCENARIO_NAME="Silent Cut of the Sender's Link, Byte Stream, Segments Only"
SCENARIO_EXPECTED="SUCCESS: the transfer resumes after the link comes back, over segments, and the file is the source"

# Authentication
ENABLE_AUTH=false
ENABLE_IDP=false

# Configuration
BYTE_STREAM_BATCH_BYTES=65536
MAX_IN_FLIGHT_BATCHES=1
RECEIVE_MAX_BYTES=8388608
NUM_SENDERS=1
NUM_RECEIVERS=1

# Transport
WRITE_TRANSPORT=SegmentsOnly
ASSERT_WRITE_TRANSPORT=Segments

# Network simulation
ENABLE_CHAOS=true
TOXIPROXY_PORT=8474
CHAOS_CLIENTS=sender
CHAOS_PROGRAM=hold
CHAOS_HOLD_START_SECONDS=2
CHAOS_HOLD_SECONDS=8
EXPECT_RESUME=true

TRANSFER_TIMEOUT_SECONDS=150
