# scripts/scenarios/byte-stream-ha-redis.env - The source file carried as bytes, through two hubs and a Redis state store
#
# byte-stream.env behind the TestProxy with two hubs, their registrations and transfer sessions shared
# through Redis (see ha-redis.env). The file must still be the source.

# Scenario description
SCENARIO_NAME="Byte Stream (HA, Redis State Store)"
SCENARIO_EXPECTED="SUCCESS: the receiver's file has the size and the SHA-256 of the source, with Redis persistence"

# Configuration
BYTE_STREAM_BATCH_BYTES=1048576
MAX_IN_FLIGHT_BATCHES=8
RECEIVE_MAX_BYTES=8388608
NUM_SENDERS=1
NUM_RECEIVERS=1

# Features
ENABLE_HA=true
ENABLE_CHAOS=false
ENABLE_IDP=false
ENABLE_EMBEDDED_IDP=false

# Transport: the default policy prefers a WebSocket, and this run must not have needed segments
ASSERT_WRITE_TRANSPORT=WebSocket

# Redis Configuration
export USE_REDIS="127.0.0.1:6379"

TRANSFER_TIMEOUT_SECONDS=150
