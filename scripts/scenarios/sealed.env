# scripts/scenarios/sealed.env - The default transfer, sealed end to end, without a pre-shared key
#
# default.env with both samples calling WithEndToEndEncryption(): 2M items through the hub as sealed batches. It proves
# what default cannot: both ends reach the same level on a real hub (each says Encrypted, from
# TransferInfo.Protection), and a transfer whose every batch is sealed and opened still delivers every line over a WebSocket.

# Scenario description
SCENARIO_NAME="Sealed Transfer, No Pre-Shared Key (Dev Mode)"
SCENARIO_EXPECTED="SUCCESS with every batch sealed end to end, every line delivered"

# Authentication
ENABLE_AUTH=false
ENABLE_IDP=false

# Configuration
BATCH_SIZE=500
BATCH_FLUSH_INTERVAL_MS=10000
NUM_SENDERS=1
NUM_RECEIVERS=1

# End-to-end encryption: sealed, no key
E2E_ENCRYPTION=true
ASSERT_PROTECTION=Encrypted

# Transport: sealing sits above the transport, so the default policy must still have carried this run on a WebSocket
ASSERT_WRITE_TRANSPORT=WebSocket

# Network simulation
ENABLE_CHAOS=false
