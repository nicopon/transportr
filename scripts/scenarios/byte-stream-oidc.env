# scripts/scenarios/byte-stream-oidc.env - The source file carried as bytes, under JWT authentication
#
# byte-stream.env against the TestIdp: the byte-stream clients take the same credentials as the item ones,
# and the transfer must be authorised on the control plane and on the data plane alike.

# Scenario description
SCENARIO_NAME="Byte Stream (JWT Authentication)"
SCENARIO_EXPECTED="SUCCESS: the receiver's file has the size and the SHA-256 of the source, with JWT-based group extraction"

# Authentication
ENABLE_AUTH=true
ENABLE_IDP=true
IDP_PORT=5100

# Configuration
BYTE_STREAM_BATCH_BYTES=1048576
MAX_IN_FLIGHT_BATCHES=8
RECEIVE_MAX_BYTES=8388608
NUM_SENDERS=1
NUM_RECEIVERS=1

# Transport: the default policy prefers a WebSocket, and this run must not have needed segments
ASSERT_WRITE_TRANSPORT=WebSocket

# Network simulation
ENABLE_CHAOS=false

TRANSFER_TIMEOUT_SECONDS=150
