# scripts/scenarios/slow-receiver-unbounded-bytes.env - The control for slow-receiver.env
#
# Identical to slow-receiver.env but for the byte bound, which is absent. This is what the
# receive buffer was before it had a byte dimension, and what an item count alone still allows:
# the consumer falls behind and the buffer grows to whatever half a million decoded records cost.
#
# It is NOT in test-all.sh. It is expected to use far more memory than its sibling, and it exists
# to be run next to it when someone needs the difference measured again rather than believed.

# Scenario description
SCENARIO_NAME="Slow Receiver (Item-Bounded Receive Buffer, Control)"
SCENARIO_EXPECTED="SUCCESS with a growing receiver footprint"

# Authentication
ENABLE_AUTH=false
ENABLE_IDP=false

# Configuration
BATCH_SIZE=500
BATCH_FLUSH_INTERVAL_MS=1000
NUM_SENDERS=1
NUM_RECEIVERS=1

CONSUME_ITEMS_PER_SECOND=200000

# The count alone, which is what "bounded" used to mean here.
RECEIVE_MAX_ITEMS=500000

# No ceiling asserted: this run is a measurement, not a guarantee. Sampling is on so the peak is
# still recorded in rss.csv.
MAX_RECEIVER_RSS_MB=100000
