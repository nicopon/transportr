# scripts/scenarios/embedded-idp.env - Embedded IDP benchmark (SimpleIdp in DataHub)

# Scenario description
SCENARIO_NAME="Embedded IDP Benchmark"
SCENARIO_EXPECTED="SUCCESS with embedded SimpleIdp in DataHub"

# Authentication
ENABLE_AUTH=true
ENABLE_EMBEDDED_IDP=true
ENABLE_IDP=false

# Configuration
BATCH_SIZE=5000
BATCH_FLUSH_INTERVAL_MS=10000
NUM_SENDERS=1
NUM_RECEIVERS=1

# Transport: the default policy prefers a WebSocket, and this run must not have needed segments
ASSERT_WRITE_TRANSPORT=WebSocket

# Network simulation
ENABLE_CHAOS=false

# Client credentials for automatic token acquisition (clients acquire tokens themselves)
SENDER_AUTH_CLIENTID=sender
SENDER_AUTH_SECRET=sender-secret
SENDER_AUTH_SCOPE=transportr:group:senders
RECEIVER_AUTH_CLIENTID=receiver
RECEIVER_AUTH_SECRET=receiver-secret
RECEIVER_AUTH_SCOPE=transportr:group:receivers
