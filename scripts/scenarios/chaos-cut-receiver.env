# scripts/scenarios/chaos-cut-receiver.env - One silent cut of the receiver's link
#
# The mirror of chaos-cut-sender.env: the receiver alone is behind Toxiproxy, the sender talks to
# the hub directly. Same fault, same window.
#
# What this does not isolate: a lost acknowledgement. The proxy takes down all the receiver's
# connections together, its data stream as well as the one its acknowledgements travel on, and
# with the data stream gone the sender reopens its own and re-synchronises, which recovers any
# acknowledgement lost on the way. A pass here therefore says the cut is survived, not that an
# acknowledgement lost on its own would be.

# Scenario description
SCENARIO_NAME="Silent Cut of the Receiver's Link"
SCENARIO_EXPECTED="SUCCESS: the transfer resumes after the link comes back"

# Authentication
ENABLE_AUTH=false
ENABLE_IDP=false

# Configuration
BATCH_SIZE=500
BATCH_FLUSH_INTERVAL_MS=10000
NUM_SENDERS=1
NUM_RECEIVERS=1
MAX_IN_FLIGHT_BATCHES=1

# Network simulation
ENABLE_CHAOS=true
TOXIPROXY_PORT=8474
CHAOS_CLIENTS=receiver
CHAOS_PROGRAM=hold
CHAOS_HOLD_START_SECONDS=5
CHAOS_HOLD_SECONDS=8

TRANSFER_TIMEOUT_SECONDS=150
