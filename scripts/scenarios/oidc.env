# scripts/scenarios/oidc.env - OIDC benchmark with TestIdp

# Scenario description
SCENARIO_NAME="OIDC Benchmark (JWT Authentication)"
SCENARIO_EXPECTED="SUCCESS with JWT-based group extraction"

# Authentication
ENABLE_AUTH=true
ENABLE_IDP=true
IDP_PORT=5100

# Configuration
BATCH_SIZE=5000
BATCH_FLUSH_INTERVAL_MS=10000
NUM_SENDERS=1
NUM_RECEIVERS=1

# Network simulation
ENABLE_CHAOS=false
