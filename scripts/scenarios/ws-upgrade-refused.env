# scripts/scenarios/ws-upgrade-refused.env - A path that does not relay a WebSocket upgrade
#
# The TestProxy strips Upgrade and Connection from every request (PROXY_UPGRADE=strip), as a proxy
# that forwards no hop-by-hop header does, so the hub receives a plain GET where the clients asked for
# a WebSocket and answers 426. Each client must give up on a WebSocket, say why in its log, and carry
# the whole transfer over segments.

# Scenario description
SCENARIO_NAME="WebSocket Upgrade Refused by the Path (Fallback to Segments)"
SCENARIO_EXPECTED="SUCCESS over segments, each client saying why it has no WebSocket"

# Authentication
ENABLE_AUTH=false
ENABLE_IDP=false

# Configuration
NUM_SENDERS=1
NUM_RECEIVERS=1
BATCH_SIZE=500
BATCH_FLUSH_INTERVAL_MS=500

# Infrastructure: two hubs behind the TestProxy, which refuses the upgrade
ENABLE_HA=true
PROXY_UPGRADE=strip

# Transport: the default policy, which prefers a WebSocket
ASSERT_WRITE_TRANSPORT=Segments
EXPECT_WRITE_FALLBACK=true

TRANSFER_TIMEOUT_SECONDS=300
