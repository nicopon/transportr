# scripts/scenarios/ha-redis.env
SCENARIO_NAME="HA Redis (Redis based State Store)"
SCENARIO_EXPECTED="Successful transfer with Redis persistence"

# Configuration
NUM_SENDERS=1
NUM_RECEIVERS=1
BATCH_SIZE=500
BATCH_FLUSH_INTERVAL_MS=500

# Features
ENABLE_HA=true        # HA with YARP + 2 Hubs + Redis
ENABLE_CHAOS=false     # Disabled as per user request
ENABLE_IDP=false
ENABLE_EMBEDDED_IDP=false

# Transport: the default policy prefers a WebSocket, and this run must not have needed segments
ASSERT_WRITE_TRANSPORT=WebSocket

# Redis Configuration
export USE_REDIS="127.0.0.1:6379"
