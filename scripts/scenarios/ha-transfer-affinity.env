# scripts/scenarios/ha-transfer-affinity.env - Two transfers of one sender on two hubs, the first one cut
#
# One sender opens a transfer to each of two receivers, and the two receivers sit on different hubs
# behind the TestProxy. The second transfer opens once the first is flowing, so the sender is sent to
# the second receiver's hub (an affinity redirect) while the first transfer's bridge stays on the
# first receiver's. Then the clients' links are held silent and their connections are closed, which
# makes every stream start again. Each transfer's streams must reopen on the hub that holds its
# bridge; a sender that has one affinity for all its transfers sends the first transfer's streams to
# the second one's hub, where nobody waits for them.
#
# Both ends are cut, not the sender's alone: with only the sender's connections closed, the hub ends
# the receiver's streams as well, and behind the TestProxy the receiver did not find out in time, so
# even a single transfer failed. That is a different fault from the one this scenario is about.
#
# The state store is the TestProxy's own, shared by both hubs: this is about where requests go, and a
# Redis server would add a dependency without changing that.
#
# Where the receivers register is decided by the TestProxy's balancing policy (RoundRobin: a client
# with no cookie goes to the hub after the one before it) and then checked against the hubs' logs
# before the sender starts, so the run stops with a setup error rather than test the wrong thing.
# After the run, the TestProxy's log says which hub every stream request of a transfer reached.
#
# NUM_SENDERS counts the transfers this run must complete: it is one sender process opening two.

# Scenario description
SCENARIO_NAME="HA Per-Transfer Affinity (First Transfer Cut After the Second Opened)"
SCENARIO_EXPECTED="SUCCESS: both transfers deliver every line, each through the hub that holds its bridge"

# Authentication
ENABLE_AUTH=false
ENABLE_IDP=false

# Configuration
BATCH_SIZE=500
BATCH_FLUSH_INTERVAL_MS=500
NUM_SENDERS=2
NUM_RECEIVERS=2
SENDER_PARALLELISM=2
SENDER_TRANSFER_STAGGER_SECONDS=5
MAX_IN_FLIGHT_BATCHES=1

# Infrastructure: two hubs behind the TestProxy, receivers placed in turn
ENABLE_HA=true
PROXY_LOAD_BALANCING=RoundRobin
ASSERT_TRANSFER_AFFINITY=true

# The consumers are the bottleneck, and they have to be: each transfer must still be flowing when the
# link is cut, which an unthrottled run (two million lines in a few seconds) is not. The bounded
# buffer is what makes the throttle reach the sender, since a batch is acknowledged on entering it.
CONSUME_ITEMS_PER_SECOND=40000
RECEIVE_MAX_ITEMS=2000

# Network simulation: Toxiproxy in front of the TestProxy. The cut comes well after the second
# transfer opened (the stagger, plus the redirect it causes) and well before the first one ends.
ENABLE_CHAOS=true
TOXIPROXY_PORT=8474
CHAOS_UPSTREAM_PORT=5000
CHAOS_CLIENTS=both
CHAOS_PROGRAM=hold
CHAOS_HOLD_START_SECONDS=14
CHAOS_HOLD_SECONDS=8

# Well past a clean run, so that a transfer that does not resume fails here and not when the hub
# gives up on it.
TRANSFER_TIMEOUT_SECONDS=150
