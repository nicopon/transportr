# scripts/scenarios/default.env - Default benchmark (no authentication)

# Scenario description
SCENARIO_NAME="Default Benchmark (Dev Mode)"
SCENARIO_EXPECTED="SUCCESS without authentication"

# Authentication
ENABLE_AUTH=false
ENABLE_IDP=false

# Configuration
BATCH_SIZE=500
BATCH_FLUSH_INTERVAL_MS=10000
NUM_SENDERS=1
NUM_RECEIVERS=1

# Transport: the default policy prefers a WebSocket, and this run must not have needed segments
ASSERT_WRITE_TRANSPORT=WebSocket

# Network simulation
ENABLE_CHAOS=false
