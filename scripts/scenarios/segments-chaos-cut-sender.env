# scripts/scenarios/segments-chaos-cut-sender.env - One silent cut of the sender's link, over segments
#
# chaos-cut-sender.env with both clients told not to use a WebSocket: the cut a segmented write stream
# must survive, with the reconnection that follows, stays proved while a WebSocket is the default. See
# chaos-cut-sender.env for the fault and the window.

# Scenario description
SCENARIO_NAME="Silent Cut of the Sender's Link, Segments Only"
SCENARIO_EXPECTED="SUCCESS: the transfer resumes after the link comes back, over segments"

# Authentication
ENABLE_AUTH=false
ENABLE_IDP=false

# Configuration
BATCH_SIZE=500
BATCH_FLUSH_INTERVAL_MS=10000
NUM_SENDERS=1
NUM_RECEIVERS=1
MAX_IN_FLIGHT_BATCHES=1

# Transport
WRITE_TRANSPORT=SegmentsOnly
ASSERT_WRITE_TRANSPORT=Segments

# Network simulation
ENABLE_CHAOS=true
TOXIPROXY_PORT=8474
CHAOS_CLIENTS=sender
CHAOS_PROGRAM=hold
CHAOS_HOLD_START_SECONDS=2
CHAOS_HOLD_SECONDS=8

TRANSFER_TIMEOUT_SECONDS=150
