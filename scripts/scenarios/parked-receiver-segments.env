# scripts/scenarios/parked-receiver-segments.env - A parked receiver, over segments
#
# parked-receiver.env with both clients told not to use a WebSocket: what the same idle write streams
# do when each is a succession of requests. See parked-receiver.env for the setup.

# Scenario description
SCENARIO_NAME="Parked Receiver (Idle Write Streams), Segments Only"
SCENARIO_EXPECTED="SUCCESS with every write stream carried by segments"

# Authentication
ENABLE_AUTH=false
ENABLE_IDP=false

# Configuration
BATCH_SIZE=500
BATCH_FLUSH_INTERVAL_MS=1000
NUM_SENDERS=1
NUM_RECEIVERS=1
SOURCE_MAX_ITEMS=6000
NUM_ITEMS=6000

RECEIVE_MAX_ITEMS=500
CONSUME_ITEMS_PER_SECOND=12

# Transport
WRITE_TRANSPORT=SegmentsOnly
ASSERT_WRITE_TRANSPORT=Segments

# Network simulation
ENABLE_CHAOS=false

TRANSFER_TIMEOUT_SECONDS=600
