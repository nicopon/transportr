# scripts/scenarios/chaos-cut-sender.env - One silent cut of the sender's link
#
# The sender alone is behind Toxiproxy; the receiver talks to the hub directly. Mid-transfer the
# proxy holds every byte for a few seconds - nothing refused, nothing delivered - and then closes
# all its connections. That is a cable pulled and replugged, which is not what chaos.env does: its
# resets are instantaneous, so the hub notices the loss at once and never keeps a registration
# that belongs to a stream nobody is on the other end of.
#
# The window is one batch so that a lost acknowledgement is felt at once instead of being absorbed
# by a wide window.

# Scenario description
SCENARIO_NAME="Silent Cut of the Sender's Link"
SCENARIO_EXPECTED="SUCCESS: the transfer resumes after the link comes back"

# Authentication
ENABLE_AUTH=false
ENABLE_IDP=false

# Configuration
BATCH_SIZE=500
BATCH_FLUSH_INTERVAL_MS=10000
NUM_SENDERS=1
NUM_RECEIVERS=1
MAX_IN_FLIGHT_BATCHES=1

# Network simulation
ENABLE_CHAOS=true
TOXIPROXY_PORT=8474
CHAOS_CLIENTS=sender
CHAOS_PROGRAM=hold
CHAOS_HOLD_START_SECONDS=5
CHAOS_HOLD_SECONDS=8

# Well past a clean run, well short of the hub's bridge timeout, so that a transfer that does not
# resume fails here and not five minutes later.
TRANSFER_TIMEOUT_SECONDS=150
