# scripts/scenarios/ws-required-refused.env - A WebSocket is required and the path does not relay one
#
# ws-upgrade-refused.env with both clients told to require a WebSocket: they must not fall back. The
# transfer fails, which this run counts as its success when the sender reports it with the client's
# generic message, the hub says it received a write stream with no upgrade, and no CSV holds every
# line. What becomes of the receiver is printed, not judged. run-benchmark.sh ends this run itself,
# as soon as the sender has failed and the receivers have gone or the deadline has passed.

# Scenario description
SCENARIO_NAME="WebSocket Required, Upgrade Refused by the Path"
SCENARIO_EXPECTED="FAILURE of the transfer, reported with a generic message, and nothing delivered in full"

# Authentication
ENABLE_AUTH=false
ENABLE_IDP=false

# Configuration
NUM_SENDERS=1
NUM_RECEIVERS=1
BATCH_SIZE=500
BATCH_FLUSH_INTERVAL_MS=500

# Infrastructure: two hubs behind the TestProxy, which refuses the upgrade
ENABLE_HA=true
PROXY_UPGRADE=strip

# Transport: neither client may use segments
WRITE_TRANSPORT=RequireWebSocket
EXPECT_TRANSFER_FAILURE=true

# Well past a failure that is immediate, past the hub's own inactivity bound for a transfer, so that
# what becomes of a receiver left waiting shows before the deadline.
TRANSFER_TIMEOUT_SECONDS=90
