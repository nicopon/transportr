# scripts/scenarios/byte-stream.env - The source file carried as bytes, with no serializer
#
# The sender copies data/orders.bin as it is and the receiver writes it as it is. Nothing in the
# byte-stream mode knows what an order is, so the run is judged on the size and the SHA-256 of the
# receiver's file, not on lines.
#
# The batch is cut at 1 MiB: well past the 85,000 bytes where a per-batch array would land on the large
# object heap, and small enough that the window below holds a few batches and not the file. The window
# of 8 batches and the receive bound of 8 MiB are the two ends bounded together, as the mode intends:
# a receiver that falls behind parks the read loop and withholds the acknowledgements that reopen the
# window, so neither end buffers the file.

# Scenario description
SCENARIO_NAME="Byte Stream (Dev Mode)"
SCENARIO_EXPECTED="SUCCESS: the receiver's file has the size and the SHA-256 of the source"

# Authentication
ENABLE_AUTH=false
ENABLE_IDP=false

# Configuration
BYTE_STREAM_BATCH_BYTES=1048576
MAX_IN_FLIGHT_BATCHES=8
RECEIVE_MAX_BYTES=8388608
NUM_SENDERS=1
NUM_RECEIVERS=1

# Transport: the default policy prefers a WebSocket, and this run must not have needed segments
ASSERT_WRITE_TRANSPORT=WebSocket

# Network simulation
ENABLE_CHAOS=false

# Well past a clean run, well short of the hub's bridge timeout, so that a transfer that stalls
# fails here and not five minutes later.
TRANSFER_TIMEOUT_SECONDS=150
