# scripts/scenarios/chaos-bounded.env - Chaos testing with a bounded send window
#
# Same faults as chaos.env, with the sender's in-flight window enabled. Exists to prove the
# window does not break resumption: a slot must come back on the implicit ack that a Pong
# produces, or the window closes for good after the first cut and the transfer never finishes.

# Scenario description
SCENARIO_NAME="Chaos Benchmark (Network Simulation, Bounded Send Window)"
SCENARIO_EXPECTED="SUCCESS with retries/reconnections"

# Authentication
ENABLE_AUTH=false
ENABLE_IDP=false

# Configuration
BATCH_SIZE=500
BATCH_FLUSH_INTERVAL_MS=10000
NUM_SENDERS=1
NUM_RECEIVERS=1

# Network simulation
ENABLE_CHAOS=true
TOXIPROXY_PORT=8474
NB_ITEMS=500000

# Bounded sender: backpressure from the receiver all the way to the producer.
MAX_IN_FLIGHT_BATCHES=8
