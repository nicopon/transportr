# scripts/scenarios/byte-stream-sealed-cut-sender.env - One silent cut of the sender's link, byte stream, sealed with a pre-shared key
#
# byte-stream-cut-sender.env with both samples sealing with a pre-shared key that the script generates for the run. It proves
# what its plain neighbour cannot: a resend after the cut replays the sealed batches intact (the file is still the source, by
# size and SHA-256), both ends say EncryptedWithPreSharedKey, and the key is in no file of the output, the hub's logs included.
#
# The window is one batch and the batch is cut at 64 KiB, so the hold at second 2 finds the transfer under way; the run checks
# it, as the plain scenario does.

# Scenario description
SCENARIO_NAME="Silent Cut of the Sender's Link, Byte Stream, Sealed With a Pre-Shared Key"
SCENARIO_EXPECTED="SUCCESS: the transfer resumes after the link comes back, and the file is the source"

# Authentication
ENABLE_AUTH=false
ENABLE_IDP=false

# Configuration
BYTE_STREAM_BATCH_BYTES=65536
MAX_IN_FLIGHT_BATCHES=1
RECEIVE_MAX_BYTES=8388608
NUM_SENDERS=1
NUM_RECEIVERS=1

# End-to-end encryption: sealed, with a key generated for each run
E2E_ENCRYPTION=true
E2E_PRE_SHARED_KEY=true
ASSERT_PROTECTION=EncryptedWithPreSharedKey

# Network simulation
ENABLE_CHAOS=true
TOXIPROXY_PORT=8474
CHAOS_CLIENTS=sender
CHAOS_PROGRAM=hold
CHAOS_HOLD_START_SECONDS=2
CHAOS_HOLD_SECONDS=8
EXPECT_RESUME=true

# Well past a clean run, well short of the hub's bridge timeout, so that a transfer that does not
# resume fails here and not five minutes later.
TRANSFER_TIMEOUT_SECONDS=150
