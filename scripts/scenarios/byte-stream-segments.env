# scripts/scenarios/byte-stream-segments.env - The source file carried as bytes, over segments only
#
# byte-stream.env with both clients told not to try a WebSocket: the write stream is a succession of short
# POSTs, each at an offset in an epoch, and the file must still be the source. The transport assertion
# makes the run say what carried it.

# Scenario description
SCENARIO_NAME="Byte Stream, Segments Only"
SCENARIO_EXPECTED="SUCCESS: the receiver's file has the size and the SHA-256 of the source, over segments"

# Authentication
ENABLE_AUTH=false
ENABLE_IDP=false

# Configuration
BYTE_STREAM_BATCH_BYTES=1048576
MAX_IN_FLIGHT_BATCHES=8
RECEIVE_MAX_BYTES=8388608
NUM_SENDERS=1
NUM_RECEIVERS=1

# Transport: both clients are excluded from a WebSocket, and every opening must say so
WRITE_TRANSPORT=SegmentsOnly
ASSERT_WRITE_TRANSPORT=Segments

# Network simulation
ENABLE_CHAOS=false

TRANSFER_TIMEOUT_SECONDS=150
