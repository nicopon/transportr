# scripts/scenarios/nginx-default.env - Default benchmark through a stock nginx in a container

# Scenario description
SCENARIO_NAME="Default Benchmark Behind a Stock nginx"
SCENARIO_EXPECTED="SUCCESS without authentication, through an nginx configured with nothing but a proxy_pass"

# Authentication
ENABLE_AUTH=false
ENABLE_IDP=false

# Proxy
ENABLE_NGINX=true

# Configuration
BATCH_SIZE=500
BATCH_FLUSH_INTERVAL_MS=10000
NUM_SENDERS=1
NUM_RECEIVERS=1

# Network simulation
ENABLE_CHAOS=false
