# scripts/scenarios/byte-stream-cut-sender.env - One silent cut of the sender's link, in the byte-stream mode
#
# chaos-cut-sender.env for a source carried as bytes: the sender alone is behind Toxiproxy, and
# mid-transfer the proxy holds every byte, then closes all its connections. The resend that follows is where
# a batch buffer that is still owned by the wrong side shows up: the receiver's file would then differ
# from the source, which is why the run is judged on its size and its SHA-256.
#
# The window is one batch so that a lost acknowledgement is felt at once. The batch is cut at 64 KiB so that
# the source is many batches, each waiting for its acknowledgement through the proxy: the hold at second
# 2 finds the transfer under way. The run checks it: the sender must still be alive when the hold starts
# and when it ends, so a transfer that finished before the hold fails the run instead of passing it.

# Scenario description
SCENARIO_NAME="Silent Cut of the Sender's Link, Byte Stream"
SCENARIO_EXPECTED="SUCCESS: the transfer resumes after the link comes back, and the file is the source"

# Authentication
ENABLE_AUTH=false
ENABLE_IDP=false

# Configuration
BYTE_STREAM_BATCH_BYTES=65536
MAX_IN_FLIGHT_BATCHES=1
RECEIVE_MAX_BYTES=8388608
NUM_SENDERS=1
NUM_RECEIVERS=1

# Network simulation
ENABLE_CHAOS=true
TOXIPROXY_PORT=8474
CHAOS_CLIENTS=sender
CHAOS_PROGRAM=hold
CHAOS_HOLD_START_SECONDS=2
CHAOS_HOLD_SECONDS=8

# Well past a clean run, well short of the hub's bridge timeout, so that a transfer that does not
# resume fails here and not five minutes later.
TRANSFER_TIMEOUT_SECONDS=150
