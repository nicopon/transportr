# scripts/scenarios/parked-receiver.env - A receiver that stays parked longer than a front end's idle timer
#
# The consumer takes 12 items a second from a receive buffer that holds one batch of 500, so the
# buffer is full and the hub parked on the receiver for about 40 s at a time. Both write streams are
# idle for that long: the receiver's acknowledgements are withheld by definition, and the sender is
# blocked by the full window. A write stream that a front end cuts for being idle shows here as a
# reconnection. The run lasts about eight minutes. parked-receiver-segments.env is the same run with a
# WebSocket excluded.
#
# The sender stops after 6000 items (SOURCE_MAX_ITEMS), a prefix of the source file, so that the
# consumer's pace is what the run lasts and the file stays the one every other scenario reads.

# Scenario description
SCENARIO_NAME="Parked Receiver (Idle Write Streams), Over a WebSocket"
SCENARIO_EXPECTED="SUCCESS with every write stream carried by a WebSocket"

# Authentication
ENABLE_AUTH=false
ENABLE_IDP=false

# Configuration
BATCH_SIZE=500
BATCH_FLUSH_INTERVAL_MS=1000
NUM_SENDERS=1
NUM_RECEIVERS=1
SOURCE_MAX_ITEMS=6000
NUM_ITEMS=6000

# The consumer is the bottleneck, and it has to be: the buffer holds one batch, so the receiver is
# parked for most of a batch's 500 items at 12 a second.
RECEIVE_MAX_ITEMS=500
CONSUME_ITEMS_PER_SECOND=12

# Transport: the default policy, which prefers a WebSocket
ASSERT_WRITE_TRANSPORT=WebSocket

# Network simulation
ENABLE_CHAOS=false

# Eight minutes of consumption, with room for a reconnection or two.
TRANSFER_TIMEOUT_SECONDS=600
