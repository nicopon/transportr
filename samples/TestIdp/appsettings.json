{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Idp": {
    "Clients": [
      {
        "ClientId": "sender",
        "Secret": "sender-secret",
        "DisplayName": "Sender Client",
        "Scopes": ["transportr:group:senders"]
      },
      {
        "ClientId": "receiver",
        "Secret": "receiver-secret",
        "DisplayName": "Receiver Client",
        "Scopes": ["transportr:group:receivers"]
      },
      {
        "ClientId": "test-client",
        "Secret": "secret-test",
        "DisplayName": "Test Client",
        "Scopes": ["transportr:group:test"]
      }
    ]
  }
}
