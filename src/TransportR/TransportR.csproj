<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);IDE0290</NoWarn>
    
    <!-- NuGet Package Metadata -->
    <PackageId>TransportR</PackageId>
    <Description>Core library for TransportR - High-performance data transport protocol and contracts</Description>
    <PackageTags>signalr;transport;streaming;bulk-data</PackageTags>
  </PropertyGroup>

</Project>
