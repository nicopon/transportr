<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);IDE0290</NoWarn>
    
    <!-- NuGet Package Metadata -->
    <PackageId>TransportR</PackageId>
    <Description>TransportR core: the wire protocol and the contracts shared by the client, the hub and the state stores, for moving record sets between .NET applications through a hub</Description>
    <PackageTags>signalr;transport;streaming;bulk-data</PackageTags>
  </PropertyGroup>

</Project>
