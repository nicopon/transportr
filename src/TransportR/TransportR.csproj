<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);IDE0290</NoWarn>
    
    <!-- NuGet Package Metadata -->
    <PackageId>TransportR</PackageId>
    <Description>TransportR core: the few types the client and the hub of a TransportR transfer both read, for moving record sets between .NET applications through a hub</Description>
    <PackageTags>transport;streaming;bulk-data</PackageTags>
  </PropertyGroup>

</Project>
